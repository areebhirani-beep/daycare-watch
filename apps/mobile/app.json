{
  "expo": {
    "name": "Daycare Watch",
    "slug": "daycare-watch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daycarewatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.areebhirani.daycare-watch"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D5A54",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D5A54",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-mail-composer",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Daycare Watch uses your location only to show daycares near you. Your location isn't saved."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1D5A54"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "15485eaa-d99d-4d40-b3c4-709227d8b16b"
      }
    },
    "owner": "areebhirani"
  }
}
